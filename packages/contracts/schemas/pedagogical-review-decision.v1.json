{
  "$ref": "#/definitions/PedagogicalReviewDecisionV1",
  "definitions": {
    "PedagogicalReviewDecisionV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "sourceVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceMetadata": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {}
        }
      },
      "required": [
        "version",
        "sourceVersionId",
        "decision",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
