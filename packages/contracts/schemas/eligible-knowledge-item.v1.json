{
  "$ref": "#/definitions/EligibleKnowledgeItemV1",
  "definitions": {
    "EligibleKnowledgeItemV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sourceVersionId": {
          "$ref": "#/definitions/EligibleKnowledgeItemV1/properties/id"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "textHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "score": {
          "type": "number"
        },
        "rank": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "curriculumVersionId": {
          "$ref": "#/definitions/EligibleKnowledgeItemV1/properties/id"
        },
        "curriculumNodeId": {
          "$ref": "#/definitions/EligibleKnowledgeItemV1/properties/id"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "PLATFORM_SHARED",
            "ORGANIZATION_PRIVATE"
          ]
        }
      },
      "required": [
        "version",
        "id",
        "sourceVersionId",
        "locator",
        "textHash",
        "metadata",
        "score",
        "rank",
        "curriculumVersionId",
        "curriculumNodeId",
        "visibility"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
