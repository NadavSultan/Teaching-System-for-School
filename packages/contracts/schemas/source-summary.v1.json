{
  "$ref": "#/definitions/SourceSummaryV1",
  "definitions": {
    "SourceSummaryV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "visibility": {
          "type": "string",
          "enum": [
            "PLATFORM_SHARED",
            "ORGANIZATION_PRIVATE"
          ]
        },
        "organizationId": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceSummaryV1/properties/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "DRAFT",
            "ACTIVE",
            "SUSPENDED",
            "DEPRECATED",
            "FAILED",
            "NEEDS_RE_REVIEW"
          ]
        }
      },
      "required": [
        "version",
        "id",
        "title",
        "visibility",
        "organizationId",
        "lifecycle"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
