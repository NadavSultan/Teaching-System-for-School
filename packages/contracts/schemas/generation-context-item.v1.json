{
  "$ref": "#/definitions/GenerationContextItemV1",
  "definitions": {
    "GenerationContextItemV1": {
      "type": "object",
      "properties": {
        "knowledgeItemId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceVersionId": {
          "$ref": "#/definitions/GenerationContextItemV1/properties/knowledgeItemId"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "textHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "curriculumVersionId": {
          "$ref": "#/definitions/GenerationContextItemV1/properties/knowledgeItemId"
        },
        "curriculumNodeId": {
          "$ref": "#/definitions/GenerationContextItemV1/properties/knowledgeItemId"
        },
        "rank": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "characterCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 30000
        },
        "estimatedTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "curriculumVersionId": {
                "$ref": "#/definitions/GenerationContextItemV1/properties/knowledgeItemId"
              },
              "curriculumNodeId": {
                "$ref": "#/definitions/GenerationContextItemV1/properties/knowledgeItemId"
              }
            },
            "required": [
              "curriculumVersionId",
              "curriculumNodeId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "knowledgeItemId",
        "sourceVersionId",
        "locator",
        "textHash",
        "curriculumVersionId",
        "curriculumNodeId",
        "rank",
        "score",
        "text",
        "characterCount",
        "estimatedTokens",
        "lineage"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
