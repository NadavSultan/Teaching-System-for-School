                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 10000
                                  },
                                  "order": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "scoreUnits": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 1000000
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "id": {
                                    "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
