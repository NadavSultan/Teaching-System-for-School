{
  "$ref": "#/definitions/GenerationResultV1",
  "definitions": {
    "GenerationResultV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "status": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "1.0.0"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "assessmentId": {
              "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
            },
            "operation": {
              "type": "string",
              "enum": [
                "DRAFT",
                "REGENERATE_QUESTION"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSING",
                "SUCCEEDED",
                "INSUFFICIENT_CONTEXT",
                "FAILED"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "failureCode": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "CONTEXT_EMPTY",
                    "CONTEXT_INVALIDATED",
                    "TIMEOUT",
                    "RATE_LIMITED",
                    "TRANSIENT_EXHAUSTED",
                    "PERMANENT_PROVIDER_ERROR",
                    "SCHEMA_INVALID",
                    "OUTPUT_INVALID",
                    "CONTEXT_INVALIDATED",
                    "BUDGET_EXCEEDED",
                    "CONFIGURATION_ERROR"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputRevisionId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "version",
            "id",
            "assessmentId",
            "operation",
            "state",
            "attempts",
            "failureCode",
            "outputRevisionId"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "knowledgeItemId": {
                "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
              },
              "sourceVersionId": {
                "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "textHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "curriculumVersionId": {
                "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
              },
              "curriculumNodeId": {
                "$ref": "#/definitions/GenerationResultV1/properties/status/properties/id"
              },
              "rank": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "score": {
                "type": "number",
                "minimum": 0
              },
              "characterCount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 30000
              },
              "estimatedTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "knowledgeItemId",
              "sourceVersionId",
              "locator",
              "textHash",
              "curriculumVersionId",
              "curriculumNodeId",
              "rank",
              "score",
              "characterCount",
              "estimatedTokens"
            ],
            "additionalProperties": false
          }
