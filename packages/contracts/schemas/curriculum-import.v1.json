{
  "$ref": "#/definitions/CurriculumImportV1",
  "definitions": {
    "CurriculumImportV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "curriculumId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "educationSystemCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "subjectCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "versionNumber": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "humanLabel": {
          "type": "string",
          "maxLength": 200
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/CurriculumImportV1/properties/curriculumId"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "GRADE",
                  "DOMAIN",
                  "TOPIC",
                  "SUBTOPIC",
                  "SKILL"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "sortOrder": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "difficulties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH"
                  ]
                },
                "maxItems": 3
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/CurriculumImportV1/properties/nodes/items"
                },
                "maxItems": 1000
              }
            },
            "required": [
              "code",
              "type",
              "label",
              "sortOrder"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "version",
        "code",
        "educationSystemCode",
        "subjectCode",
        "displayName",
        "versionNumber",
        "nodes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
