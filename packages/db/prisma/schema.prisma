generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LifecycleStatus {
  ACTIVE
  INACTIVE
}

enum WorkspaceType {
  PERSONAL
  SCHOOL
}

enum MembershipRole {
  TEACHER
  COORDINATOR
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum PublicationStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum SourceVisibility {
  PLATFORM_SHARED
  ORGANIZATION_PRIVATE
}

enum SourceLifecycleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DEPRECATED
  FAILED
  NEEDS_RE_REVIEW
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum UsagePermissionDecision {
  ALLOWED
  DENIED
}

enum IngestionRunStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum KnowledgeItemStatus {
  ACTIVE
  SUSPENDED
  DEPRECATED
}

enum GenerationOperation {
  DRAFT
  REGENERATE_QUESTION
}

enum GenerationRunState {
  PENDING
  PROCESSING
  SUCCEEDED
  INSUFFICIENT_CONTEXT
  FAILED
}

enum GenerationLineage {
  GENERATED
  CARRIED_FORWARD
}

enum ValidationRunState {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ValidationRuleOutcome {
  PASS
  FAIL
}

enum ValidationFindingKind {
  DETERMINISTIC
  SEMANTIC
}

enum ValidationSeverity {
  BLOCKING
  WARNING
  INFO
}

enum SemanticEvaluationState {
  SUCCEEDED
  FAILED
}

model User {
  id                         String                             @id @default(uuid()) @db.Uuid
  normalizedEmail            String                             @unique @map("normalized_email") @db.VarChar(320)
  displayName                String?                            @map("display_name") @db.VarChar(200)
  status                     LifecycleStatus                    @default(ACTIVE)
  platformAdmin              Boolean                            @default(false) @map("platform_admin")
  createdAt                  DateTime                           @default(now()) @map("created_at")
  updatedAt                  DateTime                           @updatedAt @map("updated_at")
  memberships                Membership[]
  identityMappings           IdentityMapping[]
  auditEvents                AuditEvent[]                       @relation("AuditActor")
  pedagogicalReviews         PedagogicalReview[]
  usagePermissions           UsagePermission[]
  sourceLifecycleEvents      SourceLifecycleEvent[]
  generationRuns             GenerationRun[]
  validationRuns             ValidationRun[]
  validationAcknowledgements ValidationFindingAcknowledgement[]

  @@map("users")
}

model IdentityMapping {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(80)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("identity_mappings")
}

model Organization {
  id                         String                             @id @default(uuid()) @db.Uuid
  name                       String                             @db.VarChar(200)
  workspaceType              WorkspaceType                      @map("workspace_type")
  status                     LifecycleStatus                    @default(ACTIVE)
  createdAt                  DateTime                           @default(now()) @map("created_at")
  updatedAt                  DateTime                           @updatedAt @map("updated_at")
  memberships                Membership[]
  auditEvents                AuditEvent[]
  outboxEvents               OutboxEvent[]
  assessments                Assessment[]
  generationRuns             GenerationRun[]
  validationRuns             ValidationRun[]
  validationFindings         ValidationFinding[]
  validationAcknowledgements ValidationFindingAcknowledgement[]
  knowledgeSources           KnowledgeSource[]
  auditSourceEvents          SourceLifecycleEvent[]

  @@map("organizations")
}

model Membership {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  role           MembershipRole
  status         LifecycleStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  eventType      String        @map("event_type") @db.VarChar(120)
  targetType     String        @map("target_type") @db.VarChar(120)
  targetId       String        @map("target_id") @db.VarChar(255)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  eventType      String            @map("event_type") @db.VarChar(120)
  payload        Json
  status         PublicationStatus @default(PENDING)
  attemptCount   Int               @default(0) @map("attempt_count")
  availableAt    DateTime          @default(now()) @map("available_at")
  publishedAt    DateTime?         @map("published_at")
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(255)
  lastError      String?           @map("last_error") @db.VarChar(500)
  lockedAt       DateTime?         @map("locked_at")
  leaseExpiresAt DateTime?         @map("lease_expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum CurriculumLifecycle {
  ACTIVE
  DEPRECATED
}

enum CurriculumVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum CurriculumNodeType {
  GRADE
  DOMAIN
  TOPIC
  SUBTOPIC
  SKILL
}

enum DifficultyBand {
  LOW
  MEDIUM
  HIGH
}

enum AssessmentType {
  WORKSHEET
  TEST
}

enum ScoringMode {
  NONE
  POINTS
}

enum AssessmentRevisionState {
  BUILDING
  FINALIZED
}

model Curriculum {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique @db.VarChar(64)
  educationSystemCode String              @map("education_system_code") @db.VarChar(64)
  subjectCode         String              @map("subject_code") @db.VarChar(64)
  displayName         String              @map("display_name") @db.VarChar(200)
  lifecycle           CurriculumLifecycle @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  versions            CurriculumVersion[]

  @@map("curricula")
}

model CurriculumVersion {
  id                  String                            @id @default(uuid()) @db.Uuid
  curriculumId        String                            @map("curriculum_id") @db.Uuid
  versionNumber       Int                               @map("version_number")
  humanLabel          String?                           @map("human_label") @db.VarChar(200)
  status              CurriculumVersionStatus           @default(DRAFT)
  publishedAt         DateTime?                         @map("published_at")
  deprecatedAt        DateTime?                         @map("deprecated_at")
  createdAt           DateTime                          @default(now()) @map("created_at")
  curriculum          Curriculum                        @relation(fields: [curriculumId], references: [id])
  nodes               CurriculumNode[]
  revisions           AssessmentRevision[]
  knowledgeItemLinks  KnowledgeItemCurriculumNodeLink[]
  sourceVersionLinks  SourceVersionCurriculumNodeLink[]
  generationContexts  GenerationContextItem[]
  questionSourceLinks QuestionSourceLink[]
  generationRuns      GenerationRun[]

  @@unique([curriculumId, versionNumber])
  @@map("curriculum_versions")
}

model CurriculumNode {
  id                  String                            @id @default(uuid()) @db.Uuid
  versionId           String                            @map("version_id") @db.Uuid
  parentId            String?                           @map("parent_id") @db.Uuid
  type                CurriculumNodeType
  code                String
  label               String
  description         String?                           @db.VarChar(2000)
  sortOrder           Int                               @map("sort_order")
  version             CurriculumVersion                 @relation(fields: [versionId], references: [id])
  parent              CurriculumNode?                   @relation("Tree", fields: [parentId], references: [id])
  children            CurriculumNode[]                  @relation("Tree")
  difficulties        CurriculumSkillDifficulty[]
  links               AssessmentRevisionNodeLink[]
  knowledgeItemLinks  KnowledgeItemCurriculumNodeLink[]
  sourceVersionLinks  SourceVersionCurriculumNodeLink[]
  generationContexts  GenerationContextItem[]
  questionSourceLinks QuestionSourceLink[]

  @@map("curriculum_nodes")
}

model KnowledgeSource {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String?                @map("organization_id") @db.Uuid
  visibility      SourceVisibility
  title           String                 @db.VarChar(200)
  origin          String                 @db.VarChar(120)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions        SourceVersion[]
  lifecycleEvents SourceLifecycleEvent[]

  @@index([organizationId, visibility])
  @@map("knowledge_sources")
}

model SourceVersion {
  id                  String                            @id @default(uuid()) @db.Uuid
  sourceId            String                            @map("source_id") @db.Uuid
  versionNumber       Int                               @map("version_number")
  contentHash         String                            @map("content_hash") @db.Char(64)
  contentReference    String                            @map("content_reference") @db.VarChar(1000)
  contentMimeType     String                            @map("content_mime_type") @db.VarChar(120)
  metadata            Json                              @default("{}")
  requestFingerprint  String                            @map("request_fingerprint") @db.Char(64)
  idempotencyKey      String                            @map("idempotency_key") @db.VarChar(255)
  lifecycle           SourceLifecycleStatus             @default(DRAFT)
  createdAt           DateTime                          @default(now()) @map("created_at")
  updatedAt           DateTime                          @updatedAt @map("updated_at")
  source              KnowledgeSource                   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  reviews             PedagogicalReview[]
  permissions         UsagePermission[]
  lifecycleEvents     SourceLifecycleEvent[]
  ingestionRuns       IngestionRun[]
  knowledgeItems      KnowledgeItem[]
  curriculumLinks     SourceVersionCurriculumNodeLink[]
  content             SourceVersionContent?
  generationContexts  GenerationContextItem[]
  questionSourceLinks QuestionSourceLink[]

  @@unique([sourceId, contentHash])
  @@unique([sourceId, idempotencyKey])
  @@unique([sourceId, versionNumber])
  @@index([contentHash, lifecycle])
  @@map("source_versions")
}

model PedagogicalReview {
  id               String         @id @default(uuid()) @db.Uuid
  sourceVersionId  String         @map("source_version_id") @db.Uuid
  reviewerUserId   String         @map("reviewer_user_id") @db.Uuid
  decision         ReviewDecision
  reason           String         @db.VarChar(1000)
  evidenceMetadata Json           @default("{}") @map("evidence_metadata")
  createdAt        DateTime       @default(now()) @map("created_at")
  sourceVersion    SourceVersion  @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  reviewer         User           @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([sourceVersionId, createdAt])
  @@map("pedagogical_reviews")
}

model UsagePermission {
  id                String                  @id @default(uuid()) @db.Uuid
  sourceVersionId   String                  @map("source_version_id") @db.Uuid
  reviewerUserId    String                  @map("reviewer_user_id") @db.Uuid
  decision          UsagePermissionDecision
  evidenceReference String                  @map("evidence_reference") @db.VarChar(1000)
  scope             String                  @db.VarChar(200)
  validUntil        DateTime?               @map("valid_until")
  createdAt         DateTime                @default(now()) @map("created_at")
  sourceVersion     SourceVersion           @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  reviewer          User                    @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([sourceVersionId, createdAt])
  @@map("usage_permissions")
}

model SourceLifecycleEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  sourceId        String?                @map("source_id") @db.Uuid
  sourceVersionId String?                @map("source_version_id") @db.Uuid
  organizationId  String?                @map("organization_id") @db.Uuid
  actorUserId     String?                @map("actor_user_id") @db.Uuid
  fromStatus      SourceLifecycleStatus? @map("from_status")
  toStatus        SourceLifecycleStatus  @map("to_status")
  reason          String                 @db.VarChar(1000)
  safeMetadata    Json                   @default("{}") @map("safe_metadata")
  createdAt       DateTime               @default(now()) @map("created_at")
  source          KnowledgeSource?       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceVersion   SourceVersion?         @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor           User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([sourceVersionId, createdAt])
  @@map("source_lifecycle_events")
}

model IngestionRun {
  id              String             @id @default(uuid()) @db.Uuid
  sourceVersionId String             @map("source_version_id") @db.Uuid
  contentHash     String             @map("content_hash") @db.Char(64)
  pipelineVersion String             @map("pipeline_version") @db.VarChar(80)
  parserVersion   String             @map("parser_version") @db.VarChar(80)
  status          IngestionRunStatus @default(PENDING)
  attempts        Int                @default(0)
  failureClass    String?            @map("failure_class") @db.VarChar(120)
  startedAt       DateTime?          @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  sourceVersion   SourceVersion      @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  knowledgeItems  KnowledgeItem[]

  @@unique([sourceVersionId, contentHash, pipelineVersion])
  @@map("ingestion_runs")
}

model SourceVersionContent {
  sourceVersionId String        @id @map("source_version_id") @db.Uuid
  contentHash     String        @map("content_hash") @db.Char(64)
  content         String        @db.VarChar(1000000)
  createdAt       DateTime      @default(now()) @map("created_at")
  sourceVersion   SourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)

  @@map("source_version_contents")
}

model KnowledgeItem {
  id                  String                            @id @default(uuid()) @db.Uuid
  sourceVersionId     String                            @map("source_version_id") @db.Uuid
  ingestionRunId      String                            @map("ingestion_run_id") @db.Uuid
  organizationId      String?                           @map("organization_id") @db.Uuid
  visibility          SourceVisibility
  locator             String                            @db.VarChar(500)
  normalizedText      String                            @map("normalized_text") @db.VarChar(30000)
  textHash            String                            @map("text_hash") @db.Char(64)
  metadata            Json                              @default("{}")
  pipelineVersion     String                            @map("pipeline_version") @db.VarChar(80)
  parserVersion       String                            @map("parser_version") @db.VarChar(80)
  status              KnowledgeItemStatus               @default(ACTIVE)
  searchVector        Unsupported("tsvector")?
  createdAt           DateTime                          @default(now()) @map("created_at")
  updatedAt           DateTime                          @updatedAt @map("updated_at")
  sourceVersion       SourceVersion                     @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  ingestionRun        IngestionRun                      @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)
  curriculumLinks     KnowledgeItemCurriculumNodeLink[]
  generationContexts  GenerationContextItem[]
  questionSourceLinks QuestionSourceLink[]

  @@unique([sourceVersionId, locator, textHash])
  @@index([organizationId, visibility, status])
  @@map("knowledge_items")
}

model SourceVersionCurriculumNodeLink {
  id                  String            @id @default(uuid()) @db.Uuid
  sourceVersionId     String            @map("source_version_id") @db.Uuid
  curriculumVersionId String            @map("curriculum_version_id") @db.Uuid
  curriculumNodeId    String            @map("curriculum_node_id") @db.Uuid
  sourceVersion       SourceVersion     @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  curriculumNode      CurriculumNode    @relation(fields: [curriculumNodeId], references: [id], onDelete: Restrict)

  @@unique([sourceVersionId, curriculumNodeId])
  @@map("source_version_curriculum_node_links")
}

model KnowledgeItemCurriculumNodeLink {
  id                  String            @id @default(uuid()) @db.Uuid
  knowledgeItemId     String            @map("knowledge_item_id") @db.Uuid
  curriculumVersionId String            @map("curriculum_version_id") @db.Uuid
  curriculumNodeId    String            @map("curriculum_node_id") @db.Uuid
  knowledgeItem       KnowledgeItem     @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  curriculumNode      CurriculumNode    @relation(fields: [curriculumNodeId], references: [id], onDelete: Restrict)

  @@unique([knowledgeItemId, curriculumNodeId])
  @@index([curriculumVersionId, curriculumNodeId])
  @@map("knowledge_item_curriculum_node_links")
}

model CurriculumSkillDifficulty {
  id     String         @id @default(uuid()) @db.Uuid
  nodeId String         @map("node_id") @db.Uuid
  band   DifficultyBand
  node   CurriculumNode @relation(fields: [nodeId], references: [id])

  @@map("curriculum_skill_difficulties")
}

model Assessment {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  type            AssessmentType
  title           String
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  organization    Organization         @relation(fields: [organizationId], references: [id])
  revisions       AssessmentRevision[]
  generationRuns  GenerationRun[]
  validationRuns  ValidationRun[]

  @@map("assessments")
}

model AssessmentRevision {
  id                   String                       @id @default(uuid()) @db.Uuid
  assessmentId         String                       @map("assessment_id") @db.Uuid
  revisionNumber       Int                          @map("revision_number")
  idempotencyKey       String                       @map("idempotency_key")
  requestFingerprint   String                       @map("request_fingerprint") @db.Char(64)
  state                AssessmentRevisionState      @default(BUILDING)
  curriculumVersionId  String                       @map("curriculum_version_id") @db.Uuid
  scoringMode          ScoringMode                  @map("scoring_mode")
  totalScoreUnits      Int?                         @map("total_score_units")
  createdAt            DateTime                     @default(now()) @map("created_at")
  assessment           Assessment                   @relation(fields: [assessmentId], references: [id])
  curriculumVersion    CurriculumVersion            @relation(fields: [curriculumVersionId], references: [id])
  sections             AssessmentSection[]
  nodeLinks            AssessmentRevisionNodeLink[]
  baseGenerationRuns   GenerationRun[]              @relation("GenerationBaseRevision")
  outputGenerationRuns GenerationRun[]              @relation("GenerationOutputRevision")
  validationRuns       ValidationRun[]
  validationFindings   ValidationFinding[]

  @@unique([assessmentId, revisionNumber])
  @@unique([assessmentId, idempotencyKey])
  @@map("assessment_revisions")
}

model ValidationRuleDefinition {
  id                 String                    @id @default(uuid()) @db.Uuid
  rulesetVersion     String                    @map("ruleset_version") @db.VarChar(40)
  ruleId             String                    @map("rule_id") @db.VarChar(120)
  ruleVersion        String                    @map("rule_version") @db.VarChar(40)
  category           String                    @db.VarChar(120)
  defaultSeverity    ValidationSeverity        @map("default_severity")
  deterministicOrder Int                       @map("deterministic_order")
  createdAt          DateTime                  @default(now()) @map("created_at")
  executions         ValidationRuleExecution[]

  @@unique([rulesetVersion, ruleId, ruleVersion])
  @@unique([rulesetVersion, deterministicOrder])
  @@map("validation_rule_definitions")
}

model ValidationRun {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @map("organization_id") @db.Uuid
  assessmentId           String                    @map("assessment_id") @db.Uuid
  assessmentRevisionId   String                    @map("assessment_revision_id") @db.Uuid
  requestingUserId       String                    @map("requesting_user_id") @db.Uuid
  operation              String                    @default("VALIDATE") @db.VarChar(40)
  rulesetVersion         String                    @map("ruleset_version") @db.VarChar(40)
  evaluatorVersion       String                    @map("evaluator_version") @db.VarChar(40)
  revisionSequence       Int                       @map("revision_sequence")
  idempotencyKey         String                    @map("idempotency_key") @db.VarChar(255)
  requestFingerprint     String                    @map("request_fingerprint") @db.Char(64)
  state                  ValidationRunState        @default(PENDING)
  attempts               Int                       @default(0)
  failureCode            String?                   @map("failure_code") @db.VarChar(80)
  leaseExpiresAt         DateTime?                 @map("lease_expires_at")
  processingStartedAt    DateTime?                 @map("processing_started_at")
  completedAt            DateTime?                 @map("completed_at")
  deterministicPassCount Int                       @default(0) @map("deterministic_pass_count")
  deterministicFailCount Int                       @default(0) @map("deterministic_fail_count")
  semanticFindingCount   Int                       @default(0) @map("semantic_finding_count")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assessment             Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assessmentRevision     AssessmentRevision        @relation(fields: [assessmentRevisionId], references: [id], onDelete: Restrict)
  requestingUser         User                      @relation(fields: [requestingUserId], references: [id], onDelete: Restrict)
  executions             ValidationRuleExecution[]
  semanticEvaluation     SemanticEvaluation?
  findings               ValidationFinding[]

  @@unique([organizationId, assessmentRevisionId, revisionSequence])
  @@unique([organizationId, assessmentRevisionId, idempotencyKey])
  @@index([organizationId, assessmentRevisionId, revisionSequence])
  @@index([state, leaseExpiresAt])
  @@map("validation_runs")
}

model ValidationRuleExecution {
  id               String                   @id @default(uuid()) @db.Uuid
  validationRunId  String                   @map("validation_run_id") @db.Uuid
  ruleDefinitionId String                   @map("rule_definition_id") @db.Uuid
  outcome          ValidationRuleOutcome
  evidence         Json                     @default("{}")
  createdAt        DateTime                 @default(now()) @map("created_at")
  validationRun    ValidationRun            @relation(fields: [validationRunId], references: [id], onDelete: Restrict)
  ruleDefinition   ValidationRuleDefinition @relation(fields: [ruleDefinitionId], references: [id], onDelete: Restrict)
  finding          ValidationFinding?

  @@unique([validationRunId, ruleDefinitionId])
  @@map("validation_rule_executions")
}

model SemanticEvaluation {
  id                        String                  @id @default(uuid()) @db.Uuid
  validationRunId           String                  @unique @map("validation_run_id") @db.Uuid
  evaluatorVersion          String                  @map("evaluator_version") @db.VarChar(40)
  promptVersion             String                  @map("prompt_version") @db.VarChar(40)
  modelConfigurationVersion String                  @map("model_configuration_version") @db.VarChar(40)
  schemaVersion             String                  @map("schema_version") @db.VarChar(40)
  state                     SemanticEvaluationState
  failureCode               String?                 @map("failure_code") @db.VarChar(80)
  latencyMs                 Int?                    @map("latency_ms")
  usage                     Json                    @default("{}")
  createdAt                 DateTime                @default(now()) @map("created_at")
  validationRun             ValidationRun           @relation(fields: [validationRunId], references: [id], onDelete: Restrict)
  findings                  ValidationFinding[]

  @@map("semantic_evaluations")
}

model ValidationFinding {
  id                    String                             @id @default(uuid()) @db.Uuid
  organizationId        String                             @map("organization_id") @db.Uuid
  validationRunId       String                             @map("validation_run_id") @db.Uuid
  assessmentRevisionId  String                             @map("assessment_revision_id") @db.Uuid
  executionId           String?                            @unique @map("execution_id") @db.Uuid
  semanticEvaluationId  String?                            @map("semantic_evaluation_id") @db.Uuid
  kind                  ValidationFindingKind
  code                  String                             @db.VarChar(120)
  category              String                             @db.VarChar(120)
  severity              ValidationSeverity
  path                  String                             @db.VarChar(500)
  messageKey            String                             @map("message_key") @db.VarChar(160)
  evidence              Json                               @default("{}")
  confidenceBasisPoints Int?                               @map("confidence_basis_points")
  ruleVersion           String?                            @map("rule_version") @db.VarChar(40)
  evaluatorVersion      String?                            @map("evaluator_version") @db.VarChar(40)
  createdAt             DateTime                           @default(now()) @map("created_at")
  organization          Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  validationRun         ValidationRun                      @relation(fields: [validationRunId], references: [id], onDelete: Restrict)
  assessmentRevision    AssessmentRevision                 @relation(fields: [assessmentRevisionId], references: [id], onDelete: Restrict)
  execution             ValidationRuleExecution?           @relation(fields: [executionId], references: [id], onDelete: Restrict)
  semanticEvaluation    SemanticEvaluation?                @relation(fields: [semanticEvaluationId], references: [id], onDelete: Restrict)
  acknowledgements      ValidationFindingAcknowledgement[]

  @@index([organizationId, validationRunId, createdAt])
  @@map("validation_findings")
}

model ValidationFindingAcknowledgement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  findingId      String            @map("finding_id") @db.Uuid
  actorUserId    String            @map("actor_user_id") @db.Uuid
  idempotencyKey String            @map("idempotency_key") @db.VarChar(255)
  reason         String            @db.VarChar(1000)
  reasonHash     String            @map("reason_hash") @db.Char(64)
  createdAt      DateTime          @default(now()) @map("created_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  finding        ValidationFinding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  actor          User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, findingId, idempotencyKey])
  @@map("validation_finding_acknowledgements")
}

model AssessmentRevisionNodeLink {
  id               String             @id @default(uuid()) @db.Uuid
  revisionId       String             @map("revision_id") @db.Uuid
  curriculumNodeId String             @map("curriculum_node_id") @db.Uuid
  revision         AssessmentRevision @relation(fields: [revisionId], references: [id])
  node             CurriculumNode     @relation(fields: [curriculumNodeId], references: [id])

  @@map("assessment_revision_node_links")
}

model AssessmentSection {
  id           String               @id @default(uuid()) @db.Uuid
  revisionId   String               @map("revision_id") @db.Uuid
  key          String
  title        String
  instructions String?              @db.VarChar(5000)
  order        Int
  scoreUnits   Int?                 @map("score_units")
  revision     AssessmentRevision   @relation(fields: [revisionId], references: [id])
  questions    AssessmentQuestion[]

  @@map("assessment_sections")
}

model AssessmentQuestion {
  id                   String                  @id @default(uuid()) @db.Uuid
  sectionId            String                  @map("section_id") @db.Uuid
  key                  String
  type                 String
  prompt               String
  instructions         String?                 @db.VarChar(5000)
  difficulty           DifficultyBand?
  order                Int
  scoreUnits           Int?                    @map("score_units")
  section              AssessmentSection       @relation(fields: [sectionId], references: [id])
  subQuestions         AssessmentSubQuestion[]
  answers              Answer[]
  rubrics              RubricCriterion[]
  questionSourceLinks  QuestionSourceLink[]
  targetGenerationRuns GenerationRun[]         @relation("GenerationTargetQuestion")

  @@map("assessment_questions")
}

model AssessmentSubQuestion {
  id         String             @id @default(uuid()) @db.Uuid
  questionId String             @map("question_id") @db.Uuid
  key        String
  prompt     String
  order      Int
  scoreUnits Int?               @map("score_units")
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])
  answers    Answer[]
  rubrics    RubricCriterion[]

  @@map("assessment_sub_questions")
}

model Answer {
  id            String                 @id @default(uuid()) @db.Uuid
  questionId    String?                @map("question_id") @db.Uuid
  subQuestionId String?                @map("sub_question_id") @db.Uuid
  answerData    Json                   @map("answer_data")
  key           String                 @db.VarChar(100)
  order         Int
  text          String                 @db.VarChar(10000)
  explanation   String?                @db.VarChar(10000)
  question      AssessmentQuestion?    @relation(fields: [questionId], references: [id])
  subQuestion   AssessmentSubQuestion? @relation(fields: [subQuestionId], references: [id])

  @@map("answers")
}

model RubricCriterion {
  id            String                 @id @default(uuid()) @db.Uuid
  questionId    String?                @map("question_id") @db.Uuid
  subQuestionId String?                @map("sub_question_id") @db.Uuid
  key           String
  description   String
  order         Int
  scoreUnits    Int?                   @map("score_units")
  question      AssessmentQuestion?    @relation(fields: [questionId], references: [id])
  subQuestion   AssessmentSubQuestion? @relation(fields: [subQuestionId], references: [id])

  @@map("rubric_criteria")
}

model GenerationRun {
  id                        String                  @id @default(uuid()) @db.Uuid
  organizationId            String                  @map("organization_id") @db.Uuid
  requestingUserId          String                  @map("requesting_user_id") @db.Uuid
  assessmentId              String                  @map("assessment_id") @db.Uuid
  operation                 GenerationOperation
  idempotencyKey            String                  @map("idempotency_key") @db.VarChar(255)
  requestFingerprint        String                  @map("request_fingerprint") @db.Char(64)
  frozenSpecification       Json                    @map("frozen_specification")
  curriculumVersionId       String                  @map("curriculum_version_id") @db.Uuid
  baseRevisionId            String?                 @map("base_revision_id") @db.Uuid
  targetQuestionId          String?                 @map("target_question_id") @db.Uuid
  state                     GenerationRunState      @default(PENDING)
  attempts                  Int                     @default(0)
  failureCode               String?                 @map("failure_code") @db.VarChar(80)
  promptTemplateVersion     String                  @map("prompt_template_version") @db.VarChar(80)
  promptTemplateHash        String                  @map("prompt_template_hash") @db.Char(64)
  modelConfigurationVersion String                  @map("model_configuration_version") @db.VarChar(80)
  modelConfigurationHash    String                  @map("model_configuration_hash") @db.Char(64)
  responseSchemaVersion     String                  @map("response_schema_version") @db.VarChar(40)
  responseSchemaHash        String                  @map("response_schema_hash") @db.Char(64)
  provider                  String?                 @db.VarChar(80)
  model                     String?                 @db.VarChar(120)
  outputRevisionId          String?                 @map("output_revision_id") @db.Uuid
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  processedAt               DateTime?               @map("processed_at")
  processingStartedAt       DateTime?               @map("processing_started_at")
  leaseExpiresAt            DateTime?               @map("lease_expires_at")
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestingUser            User                    @relation(fields: [requestingUserId], references: [id], onDelete: Restrict)
  assessment                Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  curriculumVersion         CurriculumVersion       @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  baseRevision              AssessmentRevision?     @relation("GenerationBaseRevision", fields: [baseRevisionId], references: [id], onDelete: Restrict)
  targetQuestion            AssessmentQuestion?     @relation("GenerationTargetQuestion", fields: [targetQuestionId], references: [id], onDelete: Restrict)
  outputRevision            AssessmentRevision?     @relation("GenerationOutputRevision", fields: [outputRevisionId], references: [id], onDelete: Restrict)
  contextItems              GenerationContextItem[]
  usage                     GenerationUsage[]
  questionSourceLinks       QuestionSourceLink[]

  @@unique([organizationId, assessmentId, idempotencyKey])
  @@index([organizationId, state, createdAt])
  @@map("generation_runs")
}

model GenerationContextItem {
  id                  String            @id @default(uuid()) @db.Uuid
  generationRunId     String            @map("generation_run_id") @db.Uuid
  selectedOrder       Int               @map("selected_order")
  knowledgeItemId     String            @map("knowledge_item_id") @db.Uuid
  sourceVersionId     String            @map("source_version_id") @db.Uuid
  locator             String            @db.VarChar(500)
  textHash            String            @map("text_hash") @db.Char(64)
  curriculumVersionId String            @map("curriculum_version_id") @db.Uuid
  curriculumNodeId    String            @map("curriculum_node_id") @db.Uuid
  rank                Int
  score               Float
  characterCount      Int               @map("character_count")
  estimatedTokens     Int               @map("estimated_tokens")
  lineage             Json              @default("[]")
  createdAt           DateTime          @default(now()) @map("created_at")
  generationRun       GenerationRun     @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  knowledgeItem       KnowledgeItem     @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)
  sourceVersion       SourceVersion     @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  curriculumNode      CurriculumNode    @relation(fields: [curriculumNodeId], references: [id], onDelete: Restrict)

  @@unique([generationRunId, selectedOrder])
  @@unique([generationRunId, knowledgeItemId])
  @@index([knowledgeItemId])
  @@map("generation_context_items")
}

model GenerationUsage {
  id              String        @id @default(uuid()) @db.Uuid
  generationRunId String        @map("generation_run_id") @db.Uuid
  attempt         Int
  provider        String        @db.VarChar(80)
  model           String        @db.VarChar(120)
  requestId       String        @map("request_id") @db.VarChar(255)
  inputTokens     Int           @map("input_tokens")
  outputTokens    Int           @map("output_tokens")
  totalTokens     Int           @map("total_tokens")
  costMicros      Int           @map("cost_micros")
  finishReason    String        @map("finish_reason") @db.VarChar(80)
  createdAt       DateTime      @default(now()) @map("created_at")
  generationRun   GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Restrict)

  @@unique([generationRunId, attempt])
  @@index([generationRunId, createdAt])
  @@map("generation_usages")
}

model QuestionSourceLink {
  id                   String             @id @default(uuid()) @db.Uuid
  assessmentQuestionId String             @map("assessment_question_id") @db.Uuid
  generationRunId      String             @map("generation_run_id") @db.Uuid
  knowledgeItemId      String             @map("knowledge_item_id") @db.Uuid
  sourceVersionId      String             @map("source_version_id") @db.Uuid
  locator              String             @db.VarChar(500)
  textHash             String             @map("text_hash") @db.Char(64)
  curriculumVersionId  String             @map("curriculum_version_id") @db.Uuid
  curriculumNodeId     String             @map("curriculum_node_id") @db.Uuid
  lineage              GenerationLineage
  priorQuestionId      String?            @map("prior_question_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  assessmentQuestion   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Restrict)
  generationRun        GenerationRun      @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  knowledgeItem        KnowledgeItem      @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)
  sourceVersion        SourceVersion      @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  curriculumVersion    CurriculumVersion  @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  curriculumNode       CurriculumNode     @relation(fields: [curriculumNodeId], references: [id], onDelete: Restrict)

  @@unique([assessmentQuestionId, generationRunId, knowledgeItemId])
  @@index([assessmentQuestionId])
  @@map("question_source_links")
}
